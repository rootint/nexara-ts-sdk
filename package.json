{
  "name": "nexara-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Nexara speech-to-text API: transcription, diarization, speaker roles, structured LLM output",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "examples": "./run_examples.sh"
  },
  "keywords": [
    "nexara",
    "speech-to-text",
    "stt",
    "asr",
    "transcription",
    "diarization",
    "whisper",
    "audio"
  ],
  "homepage": "https://docs.nexara.ru",
  "dependencies": {
    "ajv": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
