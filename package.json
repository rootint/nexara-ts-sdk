{
  "name": "nexara-sdk",
  "version": "0.4.0",
  "description": "TypeScript SDK for the Nexara speech-to-text API: transcription, diarization, speaker roles, emotion recognition, structured LLM output, billing",
  "license": "MIT",
  "author": "Nexara",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "examples": "./run_examples.sh",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "nexara",
    "speech-to-text",
    "stt",
    "asr",
    "transcription",
    "diarization",
    "whisper",
    "audio"
  ],
  "homepage": "https://docs.nexara.ru",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootint/nexara-ts-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/rootint/nexara-ts-sdk/issues"
  },
  "dependencies": {
    "ajv": "^8.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
